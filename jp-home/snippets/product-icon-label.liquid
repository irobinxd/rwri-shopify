{%- comment -%}
  Renders a product icon with a label.
  
  Accepts:
  - icon: {Object} the image object or URL string.
  - label: {String} label text.
  - style: {String} icon style (tooltip, compact).
  
  Usage:
  {% render 'product-icon-label', icon: product.icon, label: product.title, style: 'tooltip' %}
  
  Icon images are auto-loaded by label name from:
  1. Content > Files (e.g., "glutten-free.png" for label "Glutten-free")
  2. Theme assets folder as fallback
{%- endcomment -%}

{%- liquid
  
  assign icon_source = blank
  assign icon_from_files = blank
  assign icon_from_assets = blank
  
  if icon != blank
    assign icon_source = icon
  elsif label != blank
    assign icon_name = label | handle | append: '.png'
    assign icon_from_files = images[icon_name]
    if icon_from_files != blank
      assign icon_source = icon_from_files
    else
      assign icon_from_assets = icon_name | asset_url
    endif
  endif
  
  assign show_icon = true
  if style == 'tooltip' and icon_source == blank and icon_from_assets == blank and label == blank
    assign show_icon = false
  elsif style == 'compact' and icon_source == blank and icon_from_assets == blank and label == blank
    assign show_icon = false
  endif 
  
-%}

{%- if show_icon and label != blank -%}

  <span class="text-with-icon text-with-icon--large text-with-icon--{{ style }}" 
    {% if style == 'tooltip' %} {% unless label == blank %}style="cursor:pointer"{% endunless %} {% endif %}
  >

    {%- if icon_source != blank -%}
      <span class="text-with-icon__icon" aria-hidden="true">
        <img src="{{ icon_source | image_url: width: 25, height: 25, crop: 'center' }}"
          srcset="
            {{ icon_source | image_url: width: 25, height: 25, crop: 'center' }} 25w,
            {{ icon_source | image_url: width: 50, height: 50, crop: 'center' }} 50w,
            {{ icon_source | image_url: width: 75, height: 75, crop: 'center' }} 75w
          "
          sizes="25px" width="25" height="25"
          loading="lazy"
          alt="{{ label | escape }}"
        />
      </span>
    {%- elsif icon_from_assets != blank -%}
      <span class="text-with-icon__icon" aria-hidden="true">
        <img src="{{ icon_from_assets }}"
          width="25" height="25"
          loading="lazy"
          alt="{{ label | escape }}"
          onerror="this.parentElement.style.display='none'"
        />
      </span>
    {%- endif -%}

    {%- unless label == blank -%}
      <span class="text-with-icon__label">{{ label | escape }}</span>
    {%- endunless -%}

  </span>

{%- endif -%}