{%- comment -%}
  Custom Icon Label Filter
  
  This snippet creates a client-side filter for product icon labels.
  It scans products on the page and builds a dynamic filter list.
  
  Usage:
  {% render 'custom-icon-filter', filters_default_status: section.settings.expand_filters_bydefault %}
{%- endcomment -%}

<div id="custom-icon-filter-container{% if id %}-{{ id }}{% endif %}" class="custom-icon-filter-container" data-default-open="{{ filters_default_status }}"></div>

<style>
  /* Custom icon filter styles */
  .custom-icon-filter-container .facets__list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .custom-icon-filter-container .facets__item {
    margin: 0 !important;
    padding: 0 !important;
  }
  .icon-filter-checkbox {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    padding: 0.35rem 0;
    flex-wrap: nowrap;
    user-select: none;
  }
  .icon-filter-checkbox:hover {
    opacity: 0.8;
  }
  .icon-filter-checkbox input[type="checkbox"] {
    width: 18px;
    height: 18px;
    min-width: 18px;
    cursor: pointer;
    accent-color: #70a062;
    margin: 0;
    flex-shrink: 0;
    pointer-events: auto;
  }
  .icon-filter-checkbox .icon-filter-text {
    display: inline;
    white-space: nowrap;
    cursor: pointer;
    pointer-events: auto;
  }
  .icon-filter-checkbox .icon-filter-count {
    color: #666;
    font-size: 0.9em;
    margin-left: 2px;
  }
  .icon-filter-checkbox.disabled {
    opacity: 0.5;
    pointer-events: none;
  }
  .product-item.icon-filter-hidden {
    display: none !important;
  }
  /* Active label tag - inherits all styles from active-facets__button */
  /* The SVG icon will be styled by component-facets.css automatically */
  /* No additional styles needed - matches Shopify exactly */
</style>

<script src="{{ 'custom-icon-filter.js' | asset_url }}" defer></script>
